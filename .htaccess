# Enable URL rewriting
RewriteEngine On

# Redirect all requests to /api/v1/ to the API entry point
RewriteRule ^api/v1/(.*)$ api/v1/index.php?url=$1 [QSA,L]

# Redirect all other requests to the main index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
